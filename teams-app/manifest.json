{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "packageName": "com.iisc.ragplatform.teams",
  "developer": {
    "name": "IISc RAG Platform",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "RAG Bot",
    "full": "Grounded Agentic RAG Bot"
  },
  "description": {
    "short": "Ask your knowledge base, get cited answers.",
    "full": "Query your tenant's documents from Teams and get grounded, citation-backed answers from the RAG platform."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2A6FDB",
  "bots": [
    {
      "botId": "${{TEAMS_APP_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
